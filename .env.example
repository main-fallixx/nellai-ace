# ---- Public (safe in browser; VITE_ prefix) ----
VITE_SITE_URL=https://YOUR-DOMAIN.example
VITE_PHONE_E164=            # owner's verified number, digits only with country code, e.g. 91XXXXXXXXXX
VITE_WHATSAPP_E164=         # WhatsApp number, same format (often same as phone)
VITE_OWNER_NAME=            # optional, shown in "Owner calls to confirm"
VITE_BUSINESS_ADDRESS=      # verified address, optional (used for structured data + footer)
VITE_GA_ID=                 # GA4 Measurement ID, e.g. G-XXXXXXXXXX (optional)
VITE_GOOGLE_MAPS_EMBED_KEY= # Maps Embed API key, RESTRICTED by HTTP referrer + API (optional)
VITE_SHOW_SAMPLE_CONTENT=false  # design sample reviews/ratings/stats: keep false until replaced with real data

# ---- Server only (Vercel env vars, NEVER prefix with VITE_) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # server-side only
